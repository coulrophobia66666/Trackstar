<!-- Sitemap-Index statt einzelner urlset-Datei: sitemap-pages.xml enthaelt die statischen Seiten
     (unveraendert, weiterhin manuell gepflegt), die zweite Datei wird dynamisch vom Worker
     erzeugt (siehe worker/songtext-worker.js, handleSitemapGenres) und listet nur Genre-Seiten,
     die die 30-Tracks-Schwelle bereits erreicht haben - kein Sitemap-Eintrag fuer noch leere
     Seiten. Braucht eine Cloudflare-Route, die /sitemap-genres.xml (wie auch /check/* und
     /track-metrics, /admin/aggregate-genres) an den Worker statt an die statische Pages-Seite
     weiterleitet - siehe OFFENE-PUNKTE.md fuer den einmaligen manuellen Einrichtungsschritt. -->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://overhertz.app/sitemap-pages.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://overhertz.app/sitemap-genres.xml</loc>
  </sitemap>
</sitemapindex>
